# Every setting maps to the Config field of the same name (lower case).
# Empty = use the default. API keys are billed separately from ChatGPT Plus /
# Claude Pro / Google AI Pro consumer subscriptions.

# --- AI API keys ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
# Meta Model API (Muse Spark) — public preview, US developers only.
# Copy the OpenAI-compatible base URL from https://dev.meta.ai/docs
META_MODEL_API_KEY=
META_MODEL_API_BASE_URL=

# --- Studio engines ---
# Storyboard writer: claude | gpt | gemini | muse
TEXT_PROVIDER=claude
# Scene visuals: imagen | gpt-image (images, slow zoom) | veo (video clip per scene, costly)
#                card (offline colored background, no API — for previews)
VISUAL_PROVIDER=imagen
# Narration: gemini | gpt | silent (no voice, captions + music only)
VOICE_PROVIDER=gemini
# Optional overrides when a provider renames/adds models or voices
TEXT_MODEL=
VISUAL_MODEL=
VOICE_MODEL=
VOICE_NAME=

# --- Studio output ---
CONTENT_LANGUAGE=vi
TARGET_SECONDS=40
OUTPUT_DIR=output
# Background music: put royalty-free .mp3/.wav files here; one is picked at random
MUSIC_DIR=assets/music
# Optional PNG logo shown top-right
BRAND_LOGO_PATH=
# Caption font (must support Vietnamese; Arial is on every Windows install)
SUBTITLE_FONT=Arial
# Path to ffmpeg if it is not on PATH, e.g. C:\ffmpeg\bin\ffmpeg.exe
FFMPEG_PATH=

# --- YouTube (OAuth app, see README "YouTube setup") ---
YOUTUBE_CLIENT_SECRET_FILE=client_secret.json
YOUTUBE_TOKEN_FILE=youtube_token.json

# --- TikTok (Content Posting API) ---
TIKTOK_ACCESS_TOKEN=
# SELF_ONLY until TikTok audits your app; then PUBLIC_TO_EVERYONE
TIKTOK_PRIVACY_LEVEL=SELF_ONLY

# --- Facebook Page (Meta Graph API) ---
FACEBOOK_PAGE_ID=
FACEBOOK_ACCESS_TOKEN=

# --- History / dedup / thumbnail ---
HISTORY_DB_PATH=data/history.db
DEDUP_WINDOW_DAYS=30
MAKE_THUMBNAILS=true

# --- Web dashboard ---
# Leave empty to get a random token printed at startup each time.
DASHBOARD_TOKEN=
