# Every setting maps to the Config field of the same name (lower case).
# Empty = use the default. API keys are billed separately from ChatGPT Plus /
# Claude Pro / Google AI Pro consumer subscriptions.

# --- AI API keys ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
# Meta Model API (Muse Spark) — public preview, US developers only.
# Copy the OpenAI-compatible base URL from https://dev.meta.ai/docs
META_MODEL_API_KEY=
META_MODEL_API_BASE_URL=

# --- Studio engines ---
# Storyboard writer: claude | gpt | gemini | muse
TEXT_PROVIDER=claude
# Scene visuals: imagen | gpt-image (images, slow zoom) | veo (video clip per scene, costly)
#                card (offline colored background, no API — for previews)
VISUAL_PROVIDER=imagen
# Narration: gemini | gpt | silent (no voice, captions + music only)
VOICE_PROVIDER=gemini
# Optional overrides when a provider renames/adds models or voices
TEXT_MODEL=
VISUAL_MODEL=
VOICE_MODEL=
VOICE_NAME=

# --- Studio output ---
CONTENT_LANGUAGE=vi
TARGET_SECONDS=40
OUTPUT_DIR=output
# Background music folder: .mp3/.wav files plus licenses.json listing each track's licence (see README)
MUSIC_DIR=assets/music
# Optional PNG logo shown top-right
BRAND_LOGO_PATH=
# Caption font: Be Vietnam Pro is bundled (SIL OFL); any other must be installed on the machine
SUBTITLE_FONT=Be Vietnam Pro
# karaoke = words fill with colour as they are spoken | phrase = plain lines
CAPTION_STYLE=karaoke
# estimate = timing from syllable counts | whisper = from the audio + pronunciation score
# (pip install -e ".[align]"; downloads WHISPER_MODEL from Hugging Face on first use)
CAPTION_ALIGNER=estimate
WHISPER_MODEL=small
# Keep every intermediate render file (debugging); default deletes them after success
KEEP_INTERMEDIATES=false
# Path to ffmpeg if it is not on PATH, e.g. C:\ffmpeg\bin\ffmpeg.exe
FFMPEG_PATH=

# --- Variation (anti mass-production) ---
# Rotate hook, visual style, voice and music across videos
VARIATION=true
# Comma lists; empty = all built-in options. Hooks: question,shock,list,story,myth,contrast
HOOK_STYLES=
# cinematic,documentary,illustration,3d,anime,watercolor
VISUAL_STYLES=
# Voices of your VOICE_PROVIDER to rotate, e.g. Kore,Puck,Charon (Gemini) or alloy,nova (GPT)
VOICE_NAMES=
# Rewrite a script once if it is this % similar (word 3-grams) to a recent one; 0 = off
SIMILARITY_THRESHOLD=35
# Only use music listed with a licence in MUSIC_DIR/licenses.json, and never publish without one
REQUIRE_MUSIC_LICENSE=true

# --- CapCut draft export (pip install -e ".[capcut]") ---
# true = also write an editable CapCut draft after every render
CAPCUT_EXPORT=false
# Empty = CapCut desktop's own draft folder (%LOCALAPPDATA%\CapCut\User Data\Projects\com.lveditor.draft)
CAPCUT_DRAFTS_DIR=

# --- Publishing safety ---
# true = rendered videos wait in the dashboard's review queue until approved
REQUIRE_APPROVAL=true
# Max posts per platform per rolling 24 h (0 = no cap). Platforms penalise mass posting.
MAX_POSTS_PER_DAY=3
# Flag uploads as AI-generated (YouTube containsSyntheticMedia, TikTok is_aigc) and append this line
# to captions (Vietnam Decree 142/2026 labelling)
AI_DISCLOSURE=true
AI_DISCLOSURE_TEXT=Video có sử dụng AI
# Also keep AI_DISCLOSURE_TEXT small in a corner of the video itself
AI_LABEL_OVERLAY=true
# Time zone for --cron schedules
SCHEDULE_TIMEZONE=Asia/Ho_Chi_Minh
# Each scheduled run starts up to this many minutes late, at random (posting at the same minute daily looks automated)
SCHEDULE_JITTER_MINUTES=15

# --- YouTube (OAuth app, see README "YouTube setup") ---
YOUTUBE_CLIENT_SECRET_FILE=client_secret.json
YOUTUBE_TOKEN_FILE=youtube_token.json
# public | unlisted | private
YOUTUBE_PRIVACY=public

# --- TikTok (Content Posting API) ---
# Recommended: app credentials + refresh token, so the short-lived access token is refreshed
# automatically and the rotated refresh token is saved to TIKTOK_TOKEN_FILE
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REFRESH_TOKEN=
TIKTOK_TOKEN_FILE=tiktok_token.json
# Fallback only: a static access token expires within hours
TIKTOK_ACCESS_TOKEN=
# SELF_ONLY until TikTok audits your app; then PUBLIC_TO_EVERYONE
TIKTOK_PRIVACY_LEVEL=SELF_ONLY
# direct = Direct Post API | inbox = send to the creator's TikTok inbox as a draft (scope video.upload,
# no audit needed for public posts; finish each post in the TikTok app)
TIKTOK_MODE=direct
# api = TikTok's own API (above) | upload-post = paid relay upload-post.com (audited app, public posts)
TIKTOK_VIA=api
UPLOAD_POST_API_KEY=
# Profile name the TikTok account is connected under in the Upload-Post dashboard
UPLOAD_POST_USER=

# --- Facebook Page (Meta Graph API) ---
FACEBOOK_PAGE_ID=
# A Page token, or a Business System User token with access to the Page (the Page token is derived from it)
FACEBOOK_ACCESS_TOKEN=

# --- History / dedup / thumbnail ---
HISTORY_DB_PATH=data/history.db
DEDUP_WINDOW_DAYS=30
MAKE_THUMBNAILS=true

# --- Web dashboard ---
# Leave empty to get a random token printed at startup each time.
DASHBOARD_TOKEN=
