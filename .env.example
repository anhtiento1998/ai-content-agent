# --- AI providers ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
META_MUSE_API_KEY=

# Which provider generates the script and the video.
# text: gpt | claude | gemini      video: veo | muse
TEXT_PROVIDER=claude
VIDEO_PROVIDER=veo

# --- YouTube (OAuth app, see README "YouTube setup") ---
YOUTUBE_CLIENT_SECRET_FILE=client_secret.json
YOUTUBE_TOKEN_FILE=youtube_token.json

# --- TikTok (Content Posting API) ---
TIKTOK_ACCESS_TOKEN=

# --- Meta (Facebook Page + Instagram Business) ---
FACEBOOK_PAGE_ID=
FACEBOOK_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=
